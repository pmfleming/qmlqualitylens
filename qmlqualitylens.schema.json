{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pmfleming/qmlqualitylens/qmlqualitylens.schema.json",
  "title": "qmlqualitylens config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "project_name": { "type": "string" },
    "project_root": { "type": "string" },
    "source_roots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "output_dir": { "type": "string" },
    "exclude": { "type": "array", "items": { "type": "string" } },
    "profile": { "enum": ["generic", "qtquick", "kirigami", "quickshell", "custom"] },
    "qmllint_report": { "type": "string" },
    "qmllint_command": { "type": "string" },
    "external_modules": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "external_types": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_qmllint": { "type": "boolean" },
        "new_code_only": { "type": "boolean" },
        "fail_on": { "type": "array", "items": { "enum": ["block", "warn", "review"] }, "uniqueItems": true },
        "incomplete": { "enum": ["fail", "warn", "pass"] }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cmake": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "check": { "type": "boolean" },
            "build_dir": { "type": "string", "minLength": 1 },
            "configure": { "type": "boolean" },
            "configure_arguments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "build_targets": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "build_arguments": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "qmllint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "check": { "type": "boolean" },
            "arguments": {
              "type": "array",
              "items": { "type": "string", "not": { "pattern": "^--json(?:=|$)" } }
            },
            "import_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "qmltypes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "use_environment_imports": { "type": "boolean" }
          }
        },
        "qmlformat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": { "type": "string" },
            "check": { "type": "boolean" }
          }
        },
        "qmltestrunner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "check": { "type": "boolean" },
            "arguments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "timeout_ms": { "type": "integer", "exclusiveMinimum": 0 }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "check": { "type": "boolean" },
            "arguments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "timeout_ms": { "type": "integer", "exclusiveMinimum": 0 }
          }
        },
        "qml_profiler": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "check": { "type": "boolean" },
            "arguments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "timeout_ms": { "type": "integer", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "type_roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interactive_types": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "layout_types": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "delegate_owner_types": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests": { "type": "string" },
        "runtime_warnings": { "type": "string" },
        "qml_profiler": { "type": "string" }
      }
    },
    "performance_budgets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario"],
        "properties": {
          "scenario": { "type": "string", "minLength": 1 },
          "platform": { "type": "string" },
          "frame_p95_ms": { "type": "number", "exclusiveMinimum": 0 },
          "max_event_ms": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "enforcement": { "enum": ["block", "warn", "review"] }
        }
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
          { "required": ["id"] },
          { "required": ["kind"] },
          { "required": ["file"] }
        ],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "file": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "process_boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objectTypes": { "type": "array", "items": { "type": "string" } },
        "textPatterns": { "type": "array", "items": { "type": "string" } },
        "allowedFilePatterns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fileSlocHigh": { "type": "number", "exclusiveMinimum": 0 },
        "componentObjectCountHigh": { "type": "number", "exclusiveMinimum": 0 },
        "functionCyclomaticHigh": { "type": "number", "exclusiveMinimum": 0 },
        "functionCognitiveHigh": { "type": "number", "exclusiveMinimum": 0 },
        "handlerLinesHigh": { "type": "number", "exclusiveMinimum": 0 },
        "bindingComplexityHigh": { "type": "number", "exclusiveMinimum": 0 },
        "cloneWindow": { "type": "integer", "minimum": 2 }
      }
    }
  }
}
