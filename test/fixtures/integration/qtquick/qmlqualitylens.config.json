{
  "$schema": "../../../../qmlqualitylens.schema.json",
  "project_name": "qmlqualitylens-qt-integration",
  "project_root": ".",
  "source_roots": ["."],
  "output_dir": "target/qmlqualitylens",
  "profile": "qtquick",
  "policy": {
    "require_qmllint": false,
    "new_code_only": false,
    "fail_on": ["block"],
    "incomplete": "fail"
  },
  "tools": {
    "cmake": {
      "command": "cmake",
      "check": true,
      "build_dir": "build",
      "configure": true,
      "configure_preset": "quality",
      "build_config": "Release",
      "build_targets": ["all_qmllint", "qmlqualitylens_smoke"],
      "build_arguments": ["--parallel", "2"]
    },
    "qmllint": { "check": false },
    "qmlformat": { "command": "qmlformat", "check": true },
    "ctest": {
      "command": "ctest",
      "check": true,
      "timeout_ms": 120000,
      "environment": { "QT_QPA_PLATFORM": "offscreen", "QT_QUICK_BACKEND": "software" }
    },
    "runtime": {
      "command": "build/bin/qmlqualitylens_smoke",
      "check": true,
      "arguments": [],
      "timeout_ms": 60000,
      "environment": { "QT_QPA_PLATFORM": "offscreen", "QT_QUICK_BACKEND": "software" }
    },
    "qml_profiler": {
      "command": "node",
      "check": true,
      "arguments": [
        "../../../../scripts/normalize-qml-profile.mjs",
        "--input", "profile/chrome-trace.json",
        "--scenario", "fixture-smoke",
        "--qt", "6.5+",
        "--platform", "offscreen",
        "--renderer", "software",
        "--build-type", "release"
      ],
      "timeout_ms": 60000
    }
  },
  "performance_budgets": [
    { "scenario": "fixture-smoke", "platform": "offscreen", "frame_p95_ms": 20, "max_event_ms": 5 }
  ],
  "external_modules": ["QmlQualityLens.Fixture"],
  "external_types": ["TestCase"],
  "exclude": ["build", "target"]
}
