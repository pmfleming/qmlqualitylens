{
  "$schema": "../qmlqualitylens.schema.json",
  "project_name": "shelllist",
  "project_root": "../../shelllist",
  "source_roots": ["activity", "bar", "bluetooth", "clipboard", "launcher", "shell", "wifi", "qml", "tests/qml"],
  "output_dir": "target/qmlqualitylens",
  "profile": "quickshell",
  "policy": {
    "require_qmllint": false,
    "new_code_only": true,
    "fail_on": ["block"],
    "incomplete": "warn"
  },
  "external_modules": ["QtTest"],
  "external_types": ["GlobalShortcut", "IconImage", "IpcHandler", "PanelWindow", "RectangularShadow", "Region", "ScriptAction", "Settings", "Shortcut", "SignalSpy", "TestCase", "Variants"],
  "tools": {
    "cmake": { "check": false },
    "qmllint": { "check": false },
    "qmlformat": { "check": false },
    "qmltestrunner": { "check": false },
    "runtime": { "check": false },
    "qml_profiler": { "check": false }
  },
  "exclude": ["target", ".direnv"]
}
