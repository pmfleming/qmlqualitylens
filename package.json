{
  "name": "qmlqualitylens",
  "version": "0.3.0",
  "description": "Evidence-aware quality lens for QML, Qt Quick, and Quickshell projects.",
  "type": "module",
  "main": "./dist/src/cli.js",
  "bin": {
    "qmlqualitylens": "./dist/bin/qmlqualitylens.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "parser:test": "npm run build && node --test dist/test/qml-parser.test.js",
    "oracle:qmllint": "npm run build && node dist/test/oracle-qmllint.oracle.js",
    "oracle:qmllint:nix": "nix-shell --run 'npm run oracle:qmllint'",
    "integration:qt": "npm run build && node scripts/integration-qt.mjs",
    "profile:normalize": "node scripts/normalize-qml-profile.mjs",
    "analyze:shelllist": "npm run build && node dist/bin/qmlqualitylens.js analyze --config examples/shelllist.config.json --format summary",
    "measure:shelllist": "npm run build && node dist/bin/qmlqualitylens.js measure all --config examples/shelllist.config.json",
    "calibrate": "node scripts/calibrate.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/bin/",
    "dist/src/",
    "src/",
    "bin/",
    "README.md",
    "ROADMAP.md",
    "docs/",
    "benchmarks/",
    "scripts/",
    "test/fixtures/oracle/qmllint/",
    "test/fixtures/integration/qtquick/CMakeLists.txt",
    "test/fixtures/integration/qtquick/Main.qml",
    "test/fixtures/integration/qtquick/profile/",
    "test/fixtures/integration/qtquick/qmlqualitylens.config.json",
    "test/fixtures/integration/qtquick/scripts/",
    "test/fixtures/integration/qtquick/tests/",
    "test/oracle-qmllint.oracle.ts",
    "shell.nix",
    "tsconfig.json",
    "qmlqualitylens.schema.json"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^6.0.0"
  }
}
